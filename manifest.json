{
  "manifest_version": 3,
  "name": "My AI Mirror - Reflective Awareness Monitor",
  "description": "Designed as a self-awareness and early-warning system, Sentinel™ aims to support healthier chatbot engagement and informed reflection on your digital interaction patterns.",
  "version": "1.0",

  "permissions": ["storage", "offscreen", "scripting"],
  "background": {
    "service_worker": "sentiment-worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://huggingface.co/*"
  ],
  "action": {
    "default_icon": {
      "16": "logo.png",
      "32": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": ["theme-support.js", "privacy-consent.js"]
    }
  ]
}
